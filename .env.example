# OpenAI API key used by llm.py (ChatOpenAI).
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Tavily search API key used by tavily_search tool adapter.
# 발급: https://app.tavily.com/home
TAVILY_API_KEY=

# Chroma 벡터 DB 설정 (RAG 문서 검색)
# CHROMA_DB_PATH: Chroma 영속화 디렉터리 경로
CHROMA_DB_PATH=./chroma_db
# CHROMA_COLLECTION_NAME: 사용할 컬렉션 이름
CHROMA_COLLECTION_NAME=korean_pdf

# 다중 문서 소스 설정(JSON, 선택)
# 값이 설정되면 CHROMA_DB_PATH/CHROMA_COLLECTION_NAME 대신 이 설정을 사용합니다.
# 예시:
# DOC_SOURCES_JSON={"korean_spelling":{"db_path":"./chroma_db","collection_name":"korean_pdf","description":"Korean spelling rules"},"tech_manual":{"db_path":"./chroma_db2","collection_name":"tech_docs","description":"Tech documentation"}}
DOC_SOURCES_JSON=