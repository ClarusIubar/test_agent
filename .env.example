# OpenAI API key used by llm.py (ChatOpenAI).
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Tavily search API key used by tavily_search tool adapter.
# 발급: https://app.tavily.com/home
TAVILY_API_KEY=

# Chroma 벡터 DB 설정 (RAG 문서 검색)
# CHROMA_DB_PATH: Chroma 영속화 디렉터리 경로
CHROMA_DB_PATH=./chroma_db
# CHROMA_COLLECTION_NAME: 사용할 컬렉션 이름
CHROMA_COLLECTION_NAME=korean_pdf